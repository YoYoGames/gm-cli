{
  "name": "gm",
  "author": "YoYo Games",
  "description": "GameMaker CLI",
  "license": "MIT",
  "type": "module",
  "version": "0.0.0",
  "files": [
    "dist"
  ],
  "bin": {
    "gm": "dist/cli.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prebuild": "tsc -p src/tsconfig.json",
    "build": "tsup --silent",
    "prepublishOnly": "pnpm run build"
  },
  "tsup": {
    "entry": [
      "src/bin/cli.ts"
    ],
    "format": [
      "esm"
    ],
    "tsconfig": "src/tsconfig.json",
    "clean": true,
    "splitting": true,
    "minify": true
  },
  "dependencies": {
    "@stricli/core": "^1.2.6"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "tsup": "^6.7.0",
    "typescript": "5.6.x"
  }
}
