{
  "name": "@experimental/gm",
  "author": "YoYo Games",
  "description": "GameMaker CLI",
  "license": "MIT",
  "type": "module",
  "version": "0.3.0",
  "files": [
    "dist"
  ],
  "bin": {
    "gm": "dist/cli.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prebuild": "tsc -p tsconfig.json",
    "build": "tsup --silent",
    "prepublishOnly": "pnpm run build"
  },
  "tsup": {
    "entry": [
      "src/bin/cli.ts"
    ],
    "format": [
      "esm"
    ],
    "tsconfig": "tsconfig.json",
    "clean": true,
    "splitting": true,
    "minify": true
  },
  "devDependencies": {
    "@clack/prompts": "^1.1.0",
    "@stricli/core": "^1.2.6",
    "@types/node": "24.x",
    "tsup": "^6.7.0",
    "typescript": "5.6.x"
  },
  "inlinedDependencies": {
    "@clack/core": "1.1.0",
    "@clack/prompts": "1.1.0",
    "sisteransi": "1.0.5",
    "@stricli/core": "^1.2.6"
  },
  "dependencies": {
    "zod": "^4.3.6"
  }
}
